<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="View.Views.GoalsView">

    <Grid RowDefinitions="Auto, *">
        <!-- Header & Action -->
        <Border Grid.Row="0" Background="{DynamicResource WhiteBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Personal Goals" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" />
                    <TextBlock Text="Track milestones, deadlines, and link actionable tasks to each goal." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="primary" Click="OnNewGoalClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="{DynamicResource WhiteBrush}"
                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="New Goal" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Click="OnRefreshClick" ToolTip.Tip="Refresh goals">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{DynamicResource PrimaryTextBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Goals Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" Spacing="14">
                <TextBlock x:Name="EmptyNotice" Text="No goals found. Click '+ New Goal' to define your targets!"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="False" Margin="0,20,0,0" HorizontalAlignment="Center" />

                <StackPanel x:Name="GoalsContainer" Spacing="14" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

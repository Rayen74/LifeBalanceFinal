<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="View.Dialogs.GoalDialog"
        Title="Goal Details"
        Width="440" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WhiteBrush}" Padding="24">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitle" Text="New Personal Goal" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" />
                <TextBlock Text="Define your target milestone, status, and deadline." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="Goal Title *" />
                    <TextBox x:Name="TitleTextBox" Watermark="e.g. Master C# and Avalonia desktop development" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="Description (Optional)" />
                    <TextBox x:Name="DescTextBox" Watermark="Specific outcome or success criteria" Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="*, *">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="label" Text="Status" />
                        <ComboBox x:Name="StatusComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Active" />
                            <ComboBoxItem Content="Completed" />
                            <ComboBoxItem Content="Archived" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                        <TextBlock Classes="label" Text="Target Date (YYYY-MM-DD)" />
                        <TextBox x:Name="TargetDateTextBox" Watermark="e.g. 2026-12-31" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" FontSize="12" IsVisible="False" />
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,16,0,0">
                <Button Classes="ghost" Content="Cancel" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="OnCancelClick" />
                <Button Classes="primary" Content="Save Goal" HorizontalAlignment="Stretch" Margin="6,0,0,0" Click="OnSaveClick" />
            </Grid>
        </Grid>
    </Border>
</Window>

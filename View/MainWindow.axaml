<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="View.MainWindow"
        Title="LifeBalance"
        Width="1040" Height="720"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*" Margin="32">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Classes="title" Text="LifeBalance" />
                <TextBlock Classes="subtitle" Text="How balanced does your life feel today?" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border x:Name="DbPill" Classes="pill">
                    <TextBlock x:Name="DbStatusText" Text="Checking database…" />
                </Border>
                <Button Classes="ghost" Content="Retry" Click="OnRetryClick" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">

                <!-- Balance score -->
                <Border Classes="card hero">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="BALANCE SCORE" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="BalanceText" Classes="bigNumber" Text="0" />
                            <TextBlock Text="/ 10" Classes="subtitle" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </StackPanel>
                        <TextBlock x:Name="BalanceMessage" Classes="subtitle" Text="" />
                    </StackPanel>
                </Border>

                <!-- Life areas -->
                <ItemsControl x:Name="AreasList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card area" Width="300" Margin="0,0,16,16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Classes="icon" Text="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="areaName" Text="{Binding Name}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="label" Text="{Binding ScoreText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar Classes="area" Minimum="0" Maximum="10" Value="{Binding Score}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <Button Classes="step" Content="−" Click="OnDecreaseClick" />
                                        <Button Classes="step" Content="+" Click="OnIncreaseClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

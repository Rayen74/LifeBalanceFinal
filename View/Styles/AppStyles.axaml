<!--
  LifeBalance Professional Design System
  Following strict UI/UX Pro Max and Anti-Slop standards:
  - Deep Navy (#14264D) + Royal Blue (#2563EB) + Teal (#14B8A6)
  - Accessible contrast (WCAG AA 4.5:1+)
  - Interactive touch/click targets (min 44px)
  - Visible keyboard focus states
  - Native vector icons, zero emojis, zero AI slop
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Centralized Design Tokens ===== -->
    <Styles.Resources>
        <!-- Palette Tokens from Specification -->
        <Color x:Key="NavyColor">#14264D</Color>
        <Color x:Key="NavyDarkColor">#0D1933</Color>
        <Color x:Key="PrimaryBlueColor">#2563EB</Color>
        <Color x:Key="SecondaryBlueColor">#1E40AF</Color>
        <Color x:Key="TealColor">#14B8A6</Color>
        <Color x:Key="TealDarkColor">#0D9488</Color>
        <Color x:Key="TealLightColor">#CCFBF1</Color>
        <Color x:Key="LightBackgroundColor">#F5F7FB</Color>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
        <Color x:Key="PrimaryTextColor">#17243B</Color>
        <Color x:Key="SecondaryTextColor">#7B879B</Color>
        <Color x:Key="BorderColor">#E2E8F0</Color>
        <Color x:Key="BorderHoverColor">#CBD5E1</Color>
        <Color x:Key="SuccessColor">#16A34A</Color>
        <Color x:Key="SuccessBgColor">#DCFCE7</Color>
        <Color x:Key="ErrorColor">#DC2626</Color>
        <Color x:Key="ErrorBgColor">#FEE2E2</Color>
        <Color x:Key="WarningColor">#D97706</Color>
        <Color x:Key="WarningBgColor">#FEF3C7</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
        <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}" />
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}" />
        <SolidColorBrush x:Key="SecondaryBlueBrush" Color="{StaticResource SecondaryBlueColor}" />
        <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
        <SolidColorBrush x:Key="TealDarkBrush" Color="{StaticResource TealDarkColor}" />
        <SolidColorBrush x:Key="TealLightBrush" Color="{StaticResource TealLightColor}" />
        <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackgroundColor}" />
        <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
        <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />

        <!-- Restrained Gradients (for Branding and Primary Actions) -->
        <LinearGradientBrush x:Key="NavyBrandingGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0D1933" Offset="0" />
            <GradientStop Color="#14264D" Offset="0.4" />
            <GradientStop Color="#1E40AF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#2563EB" Offset="0" />
            <GradientStop Color="#14B8A6" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#1D4ED8" Offset="0" />
            <GradientStop Color="#0D9488" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroScoreGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#14264D" Offset="0" />
            <GradientStop Color="#1A3366" Offset="0.6" />
            <GradientStop Color="#1E40AF" Offset="1" />
        </LinearGradientBrush>
    </Styles.Resources>

    <!-- ===== Global Window Base ===== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource LightBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ===== Professional Typography Scale ===== -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>

    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.bigNumber">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
    </Style>

    <!-- ===== Cards & Surfaces ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #0D172A08" />
    </Style>

    <Style Selector="Border.card.area">
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #0D172A08" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.card.area:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}" />
        <Setter Property="BoxShadow" Value="0 4 12 0 #2563EB12" />
    </Style>

    <Style Selector="Border.card.hero">
        <Setter Property="Background" Value="{DynamicResource HeroScoreGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #14264D24" />
    </Style>

    <!-- ===== Status Indicators & Pills ===== -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pill.ok">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="#86EFAC" />
    </Style>
    <Style Selector="Border.pill.bad">
        <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}" />
        <Setter Property="BorderBrush" Value="#FCA5A5" />
    </Style>
    <Style Selector="Border.pill.teal">
        <Setter Property="Background" Value="{DynamicResource TealLightBrush}" />
        <Setter Property="BorderBrush" Value="#5EEAD4" />
    </Style>
    <Style Selector="Border.pill.ok > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.pill.bad > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.pill.teal > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TealDarkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Sidebar Navigation Item ===== -->
    <Style Selector="Border.navItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.navItem:pointerover">
        <Setter Property="Background" Value="#F1F5F9" />
    </Style>
    <Style Selector="Border.navItem.active">
        <Setter Property="Background" Value="#EFF6FF" />
        <Setter Property="BorderBrush" Value="#DBEAFE" />
    </Style>
    <Style Selector="Border.navItem.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.navItem.active Path">
        <Setter Property="Fill" Value="{DynamicResource PrimaryBlueBrush}" />
    </Style>

    <!-- ===== Form Fields & Focus States ===== -->
    <Style Selector="TextBox.field">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Primary Gradient Button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientHover}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Background" Value="{DynamicResource PrimaryGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
    </Style>

    <!-- Secondary / Ghost Button -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
    </Style>

    <!-- Stepper Buttons (+ / -) -->
    <Style Selector="Button.step">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource NavyBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TealBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TealBrush}" />
    </Style>

    <!-- Text Link Button -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBlueBrush}" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBlueBrush}" />
    </Style>

    <!-- ===== Validation & Alerts ===== -->
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.alertError">
        <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}" />
        <Setter Property="BorderBrush" Value="#FCA5A5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.alertSuccess">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="#86EFAC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ===== Progress Bars ===== -->
    <Style Selector="ProgressBar.area">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
    </Style>

</Styles>

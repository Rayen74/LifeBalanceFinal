<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="View.LoginWindow"
        Title="LifeBalance - Sign in"
        Width="520" Height="680"
        MinWidth="380" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Classes="card" MaxWidth="420" Margin="24" Padding="28" VerticalAlignment="Center">
            <StackPanel Spacing="14">

                <!-- Branding -->
                <StackPanel HorizontalAlignment="Center" Spacing="2" Margin="0,0,0,8">
                    <TextBlock Classes="icon" Text="⚖️" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Classes="title" Text="LifeBalance" HorizontalAlignment="Center" />
                    <TextBlock Classes="subtitle" Text="Welcome back! Sign in to continue."
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="InfoText" Classes="success" IsVisible="False" />

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="EMAIL" />
                    <TextBox x:Name="EmailBox" Classes="field" Watermark="you@example.com" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="PASSWORD" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="PasswordBox" Classes="field" PasswordChar="•" Watermark="Your password" />
                        <Button x:Name="ToggleButton" Grid.Column="1" Classes="ghost" Content="Show"
                                Margin="8,0,0,0" Click="OnTogglePasswordClick" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Classes="error" IsVisible="False" />

                <Button x:Name="SignInButton" Classes="primary" Content="Sign in" IsDefault="True"
                        Click="OnSignInClick" />
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" IsVisible="False" Height="4" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Classes="subtitle" Text="New to LifeBalance?" Margin="0" VerticalAlignment="Center" />
                    <Button x:Name="CreateAccountButton" Classes="link" Content="Create account"
                            Click="OnCreateAccountClick" />
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>

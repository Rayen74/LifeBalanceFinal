<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="View.LoginWindow"
        Title="LifeBalance — Sign in"
        Width="1040" Height="660"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="46*, 54*">

        <!-- ================= LEFT BRANDING PANEL ================= -->
        <Border Grid.Column="0" Background="{DynamicResource NavyBrandingGradient}">
            <Grid RowDefinitions="Auto, *, Auto" Margin="44,36,40,36">

                <!-- Header: Logo & App Title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8"
                            Background="{DynamicResource PrimaryGradient}">
                        <!-- Clean Vector Balance Scale Icon -->
                        <Path Data="M12 3v17M4 7h16M4 7l-2 7h6L6 7zm14 0l-2 7h6l-2-7zM9 20h6"
                              Stroke="{DynamicResource WhiteBrush}" StrokeThickness="1.5"
                              Fill="Transparent" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="LifeBalance" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource WhiteBrush}" />
                            <TextBlock Text="." FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource TealBrush}" />
                        </StackPanel>
                        <TextBlock Text="PERSONAL WORKSPACE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TealBrush}" LetterSpacing="0.6" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Headline, Description & Feature Highlights -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="26">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource WhiteBrush}"
                                   TextWrapping="Wrap" LineHeight="38">
                            Organize your tasks.<LineBreak />
                            Balance your <Run Text="finances." Foreground="{DynamicResource TealBrush}" />
                        </TextBlock>
                        <TextBlock FontSize="14" Foreground="#94A3B8" LineHeight="22" TextWrapping="Wrap"
                                   Text="A unified desktop workspace designed to track daily habits, manage tasks, and maintain clear financial control." />
                    </StackPanel>

                    <!-- Feature Highlights -->
                    <StackPanel Spacing="16">
                        <!-- Feature 1 -->
                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource TealBrush}"
                                    VerticalAlignment="Top" Margin="0,2,12,0">
                                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="{DynamicResource WhiteBrush}" Width="12" Height="12"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Tasks, habits, and personal goals"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="Keep priorities clear and maintain steady daily momentum."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Feature 2 -->
                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource TealBrush}"
                                    VerticalAlignment="Top" Margin="0,2,12,0">
                                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="{DynamicResource WhiteBrush}" Width="12" Height="12"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Accounts, budgets, and planned payments"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="Track cash flow, project future commitments, and avoid surprises."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Feature 3 -->
                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource TealBrush}"
                                    VerticalAlignment="Top" Margin="0,2,12,0">
                                <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="{DynamicResource WhiteBrush}" Width="12" Height="12"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Private data isolated per user"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" />
                                <TextBlock Text="All personal records are kept strictly isolated and secure."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Version Label -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="v1.0" Foreground="#5EEAD4" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="LifeBalance Desktop Edition" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= RIGHT LOGIN PANEL ================= -->
        <Border Grid.Column="1" Background="{DynamicResource WhiteBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="380" Margin="40,32" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="20">

                        <!-- Title & Subtitle (Sentence case) -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Sign in" FontSize="26" />
                            <TextBlock Classes="subtitle" Text="Enter your credentials to access your workspace." />
                        </StackPanel>

                        <!-- Feedback Alerts -->
                        <Border x:Name="InfoBorder" Classes="alertSuccess" IsVisible="False">
                            <TextBlock x:Name="InfoText" Classes="success" TextWrapping="Wrap" />
                        </Border>

                        <Border x:Name="ErrorBorder" Classes="alertError" IsVisible="False">
                            <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" />
                        </Border>

                        <!-- Email Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Email address" />
                            <TextBox x:Name="EmailBox" Classes="field" Watermark="name@example.com" />
                        </StackPanel>

                        <!-- Password Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Password" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox x:Name="PasswordBox" Classes="field" PasswordChar="•"
                                         Watermark="Enter your password" />
                                <Button x:Name="ToggleButton" Grid.Column="1" Classes="ghost" Content="Show"
                                        Margin="8,0,0,0" MinHeight="44" Padding="12,0"
                                        VerticalAlignment="Stretch" Click="OnTogglePasswordClick" />
                            </Grid>
                        </StackPanel>

                        <!-- Sign In Button -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <Button x:Name="SignInButton" Classes="primary" Content="Sign in"
                                    IsDefault="True" Click="OnSignInClick" />
                            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" IsVisible="False"
                                         Height="4" CornerRadius="2"
                                         Foreground="{DynamicResource TealBrush}" />
                        </StackPanel>

                        <!-- Switch to Register Link -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,0">
                            <TextBlock Classes="subtitle" Text="Don't have an account?" Margin="0"
                                       VerticalAlignment="Center" />
                            <Button x:Name="CreateAccountButton" Classes="link" Content="Create an account"
                                    Click="OnCreateAccountClick" />
                        </StackPanel>

                        <!-- Privacy Footnote -->
                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="#F8FAFC"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                      Fill="{DynamicResource SecondaryTextBrush}" Width="12" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="Your personal data is isolated and encrypted."
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="View.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <!-- Application Design System & Theme Styles -->
        <StyleInclude Source="avares://View/Styles/AppStyles.axaml" />
    </Application.Styles>

</Application>
